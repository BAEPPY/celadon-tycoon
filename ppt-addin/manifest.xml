<?xml version="1.0" encoding="UTF-8"?>
<!-- PowerPoint content add-in: shows the classroom's live board inside a slide. Install by uploading this file
     (Home > Add-ins > Advanced/My Add-ins > Upload My Add-in) or from a shared-folder catalog. -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="ContentApp">
  <Id>95156648-78ca-4fa8-b565-b15fdd40839b</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>우리 반 청자 교실</ProviderName>
  <DefaultLocale>ko-KR</DefaultLocale>
  <DisplayName DefaultValue="청자 교실 실시간 화면"/>
  <Description DefaultValue="수업 사이트의 실시간 결과를 학생 이름 없이 슬라이드 안에 보여 줍니다."/>
  <IconUrl DefaultValue="https://celadon-tycoon.vercel.app/ppt-addin/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://celadon-tycoon.vercel.app/ppt-addin/icon-64.png"/>
  <SupportUrl DefaultValue="https://celadon-tycoon.vercel.app/ppt-addin/index.html"/>
  <AppDomains>
    <AppDomain>https://celadon-tycoon.vercel.app</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Presentation"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://celadon-tycoon.vercel.app/ppt-addin/index.html"/>
    <RequestedWidth>720</RequestedWidth>
    <RequestedHeight>480</RequestedHeight>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <AllowSnapshot>true</AllowSnapshot>
</OfficeApp>
