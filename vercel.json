{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/lesson",
      "destination": "/lesson/index.html"
    },
    {
      "source": "/teacher",
      "destination": "/teacher/index.html"
    },
    {
      "source": "/observe",
      "destination": "/observe/index.html"
    },
    {
      "source": "/model",
      "destination": "/model/index.html"
    },
    {
      "source": "/game",
      "destination": "/game/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.*-[A-Z0-9]{8}\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "functions": {
    "api/assess.js": {
      "maxDuration": 40
    },
    "api/classroom.js": {
      "maxDuration": 30
    },
    "api/cleanup-classroom.js": {
      "maxDuration": 300
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "classroom",
          "value": "1"
        }
      ],
      "destination": "/game",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/lesson",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/cleanup-classroom",
      "schedule": "*/5 * * * *"
    }
  ]
}
